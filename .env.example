# ===== SUPABASE (bắt buộc) =====
# Lấy tại: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ===== BẢO MẬT (tự đặt chuỗi ngẫu nhiên dài, không chia sẻ) =====
SESSION_SECRET=
ADMIN_PASSWORD=
CRON_SECRET=

# ===== ỨNG DỤNG =====
# URL công khai của app
APP_URL=http://localhost:3300
# Chế độ dev: API gửi OTP trả luôn mã trong response để test (đặt false khi chạy thật)
OTP_DEV_MODE=true

# ===== CHỐNG GIAN LẬN =====
# Kênh bị gắn cờ khi: follower tăng ngày > FRAUD_MULTIPLIER × trung bình 7 ngày
# VÀ tỷ lệ tương tác/follower < FRAUD_ENGAGEMENT_RATIO
FRAUD_MULTIPLIER=5
FRAUD_ENGAGEMENT_RATIO=0.01
